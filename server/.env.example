# node enviroment
NODE_ENV="development"

# port
PORT="8080"

# database
DATABASE_URL="postgresql://user:password@host/database"

# Google Cloud Pub/Sub
GCP_PROJECT_ID="your-gcp-project-id"
# Use "gcp" to publish to Google Cloud; local mode does not deliver messages.
PUBSUB_MODE="local"
PUBSUB_VERIFICATION_TOKEN="replace-with-a-long-random-token"

# confirmation email
APP_URL="http://localhost:3000"
RESEND_API_KEY="re_replace-with-your-api-key"
RESEND_SENDER="Newsletter <newsletter@example.com>"
